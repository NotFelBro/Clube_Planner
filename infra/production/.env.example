# Backend: copiar para um arquivo privado e completar os segredos.
NODE_ENV=production
PORT=3002
FRONTEND_URL=https://loja.exemplo.com
MONGODB_URI=mongodb://USUARIO:SENHA@127.0.0.1:27017/clube_planner?replicaSet=rs0&authSource=admin
JWT_ACCESS_SECRET=
EMAIL_CODE_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
# Pagamentos reais permanecem desativados.
CHECKOUT_TEST_MODE=

# Ambiente do serviço Caddy (mesmo domínio do FRONTEND_URL, sem https://).
SITE_DOMAIN=loja.exemplo.com
FRONTEND_DIST=/srv/clube-planner/frontend/dist
