NODE_ENV=development
PORT=3002

# Banco principal da aplicação
MONGODB_URI=mongodb://127.0.0.1:27017/clube_planner?replicaSet=rs0&directConnection=true

# Banco exclusivo para testes automatizados
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/clube_planner_test?replicaSet=rs0&directConnection=true

# Frontend autorizado pelo CORS
FRONTEND_URL=http://localhost:5173

# Autenticação JWT
# Substituir por um segredo forte e exclusivo no .env real
JWT_ACCESS_SECRET=substitua_por_um_segredo_aleatorio_seguro

# Segredo separado para códigos e links de e-mail (mínimo 32 bytes em produção)
EMAIL_CODE_SECRET=

# Tempo de validade do access token
JWT_ACCESS_EXPIRES_IN=15m

# Validade da sessão de refresh token, em dias
REFRESH_TOKEN_EXPIRES_DAYS=7

# Checkout de demonstração. Ativação explícita por ambiente na Vercel.
# gratuito: exemplares a R$ 0; o frete continua sendo calculado e pago no sandbox.
# mercado_pago: exemplares a R$ 1,00 ou R$ 0,50 fictícios, mais frete.
# Ambos os modos exigem vendedor e comprador de teste para pagar o pedido.
CHECKOUT_TEST_MODE=mercado_pago
CHECKOUT_SANDBOX_PREVIEW=
CHECKOUT_SANDBOX_PRODUCTION=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública HTTPS do backend + /api/v1/shop/mercado-pago/webhook
MP_WEBHOOK_URL=
# No modo mercado_pago, FRONTEND_URL também precisa ser pública HTTPS.
