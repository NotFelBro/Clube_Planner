NODE_ENV=development
PORT=3000

# Banco principal da aplicação
MONGODB_URI=mongodb://127.0.0.1:27017/clube_planner?replicaSet=rs0&directConnection=true

# Banco exclusivo para testes automatizados
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/clube_planner_test?replicaSet=rs0&directConnection=true

# Frontend autorizado pelo CORS
FRONTEND_URL=http://localhost:5173

# Autenticação JWT
# Substituir por um segredo forte e exclusivo no .env real
JWT_ACCESS_SECRET=substitua_por_um_segredo_aleatorio_seguro

# Tempo de validade do access token
JWT_ACCESS_EXPIRES_IN=15m

# Validade da sessão de refresh token, em dias
REFRESH_TOKEN_EXPIRES_DAYS=7
