{
  "name": "clube_planner",
  "version": "1.0.0",
  "description": "Backend do e-commerce Clube Planner, desenvolvido com Node.js, Express, MongoDB e Mongoose.",
  "main": "src/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "dev:manual": "node --watch src/server.manual.js",
    "checkout:check": "node scripts/check-mercado-pago.cjs",
    "checkout:preview": "node scripts/preview-checkout.cjs",
    "deploy:check": "node scripts/check-deploy.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotFelBro/Clube_Planner.git"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "ecommerce",
    "api-rest"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/NotFelBro/Clube_Planner/issues"
  },
  "homepage": "https://github.com/NotFelBro/Clube_Planner#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "nodemailer": "^10.4.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
